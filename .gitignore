*.pem

# Python cache / virtual environments
__pycache__/
*.pyc
.venv/
venv/

# Backups and timestamped files
backups/
*.bak
*_2026[0-9][0-9][0-9][0-9]_*.py
*_2026[0-9][0-9][0-9][0-9]_*.html

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
